VOLLYAI_SERVER_WS_URL=wss://volleyai.hsulab.net/api/v2/ai/providers/ws
VOLLYAI_TOKEN=replace-with-provider-token
VOLLYAI_WORKSPACE=/workspaces
VOLLYAI_PROVIDER_BUILD_ID=volleyball-analysis-engine/0.9.0+multitask-v2
VOLLYAI_INSTANCE_ID=analysis-worker-01
VOLLYAI_MAX_CONCURRENCY=1
VOLLYAI_DEVICE=cuda:0
VOLLYAI_TORCH_BACKEND=cu130
VOLLYAI_WORKER_IMAGE=volleyball-analysis-engine:local
VOLLYAI_DETECTOR_THRESHOLD=0.4
VOLLYAI_OSNET_URL=https://huggingface.co/datasets/holma91/SAM-Deep-EIoU/resolve/main/checkpoints/osnet_sports.pth.tar?download=true
VOLLYAI_MULTITASK_BATCH_SIZE=4
VOLLYAI_MULTITASK_FP16=true
VOLLYAI_MULTITASK_WARMUP=true
VOLLYAI_LOCAL_TRACKER=deep_eiou
VOLLYAI_LOCAL_SAM3_ENABLED=false
VOLLYAI_REID_EVERY=1
VOLLYAI_REID_FEATURE_ENABLED=false
VOLLYAI_REID_ASSOCIATION_ENABLED=true
VOLLYAI_IDENTITY_PREVIEW_ENABLED=true
VOLLYAI_PREWARM_MODELS=true
VOLLYAI_WRITE_DEBUG_ARTIFACTS=false
VOLLYAI_DISABLE_AMP=false

# Docker Compose host mounts. The installer replaces these with its downloaded asset paths.
VOLLYAI_MULTITASK_SDK_HOST_ROOT=/srv/vollyai/volleyball_inference_sdk
VOLLYAI_SMP_HOST_ROOT=/srv/vollyai/volleyball-analysis-engine/.models/selective-mask-propagation
