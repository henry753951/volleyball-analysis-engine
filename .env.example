VOLLYAI_SERVER_WS_URL=ws://host.docker.internal:4000/api/v1/ai/providers/ws
VOLLYAI_TOKEN=replace-with-provider-token
VOLLYAI_WORKSPACE=/workspaces
VOLLYAI_PROVIDER_BUILD_ID=volleyball-analysis-engine/0.5.0+court-lines-v1
VOLLYAI_INSTANCE_ID=analysis-worker-01
VOLLYAI_MAX_CONCURRENCY=1
VOLLYAI_DEVICE=cuda:0
VOLLYAI_RTV4_BACKEND=rolling
VOLLYAI_DETECTOR_THRESHOLD=0.4
VOLLYAI_DETECTOR_STRIDE=12
VOLLYAI_REID_EVERY=6
VOLLYAI_COURT_MODEL=v1
VOLLYAI_COURT_IMGSZ=640
VOLLYAI_COURT_BATCH_SIZE=1
VOLLYAI_COURT_LAYOUT_EVERY=10
VOLLYAI_COURT_REFRESH_EVERY=120
VOLLYAI_COURT_TRACK_EVERY=4
VOLLYAI_COURT_MAX_HOLD_FRAMES=30
VOLLYAI_COURT_DECODER=cuda
VOLLYAI_PREWARM_MODELS=true
VOLLYAI_WRITE_DEBUG_ARTIFACTS=false
VOLLYAI_DISABLE_AMP=false
VOLLYAI_RTV4_ROOT=.artifacts/rtv4
VOLLYAI_RTV4_CONFIG=.artifacts/rtv4/configs/rtv4/rtv4_x3d_volleyball_v4a_decoupled.yml
VOLLYAI_RTV4_CHECKPOINT=.artifacts/models/best_stg1.pth
VOLLYAI_SMP_ROOT=../volley-ai/upstream/selective-mask-propagation
VOLLYAI_OSNET_CHECKPOINT=../volley-ai/upstream/selective-mask-propagation/selective_mask_propagation/osnet/checkpoints/sports_model.pth.tar-60

# Docker Compose host mounts (only required for `docker compose up`).
VOLLYAI_RTV4_HOST_ROOT=H:/Repos/volleyball-analysis-engine/.artifacts/rtv4
VOLLYAI_RTV4_CHECKPOINT_HOST=H:/Repos/volleyball-analysis-engine/.artifacts/models/best_stg1.pth
VOLLYAI_SMP_HOST_ROOT=H:/Repos/volley-ai/upstream/selective-mask-propagation
